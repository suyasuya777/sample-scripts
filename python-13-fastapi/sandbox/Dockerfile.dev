# 演習用の実行環境。06_runtime の課題で書き換える教材側 Dockerfile とは別物。
# こちらは「教材をひととおり動かす土台」なので、マルチステージや非 root は入れていない。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# curl / ss / ps は障害調査の演習でコンテナ内から使う
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl procps iproute2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# exec 形式。シェルを挟まないので SIGTERM が uvicorn に直接届く（06-01/06-02 の前提）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "60"]
